# WAAMINI Production Environment Variables
# Copy values to /etc/waamini/db_config.php

# DB: On Windows/XAMPP use 127.0.0.1 + empty DB_SOCKET for fast TCP. "localhost" can add seconds (TTFB) per request.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=waamini
DB_USER=waamini_user
DB_PASS=CHANGE_ME_STRONG_PASSWORD
# Optional: 1=always reuse mysqli connections; 0=never; omit=auto (local/dev or Windows+127.0.0.1).
# DB_PERSISTENT=1

CRON_SECRET_KEY=CHANGE_ME_64_CHAR_HEX
WAAMINI_ENC_KEY=CHANGE_ME_64_CHAR_HEX
APP_ENV=local
APP_URL=https://yourdomain.com

# Google OAuth / Calendar
# Authorized redirect URI must exactly match this value in Google Cloud Console.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://yourdomain.com/waamini/auth/google-callback.php

# Meta app secret used to verify WhatsApp webhook signatures.
# FB_APP_SECRET and WHATSAPP_APP_SECRET remain supported aliases for existing installs.
META_APP_SECRET=your_meta_app_secret

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AI
OPENAI_API_KEY=
# Per-company daily cap on LLM requests (default 200; max 5000). Used by includes/ai_usage.php.
AI_DAILY_REQUEST_LIMIT=5000

# ---- Data cache (includes/cache.php) ----------------------
# file  = cache in storage/cache (default, works on any host)
# redis = Redis via REDIS_URL or REDIS_HOST/PORT; falls back to files if Redis is down
# auto  = Redis when REDIS_URL or REDIS_HOST is set, otherwise files
CACHE_DRIVER=file
CACHE_PREFIX=waamini:
CACHE_DEFAULT_TTL=60
# REDIS_URL=redis://:password@127.0.0.1:6379/0   (use rediss:// for TLS)
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT=1.0
REDIS_PERSISTENT=1
