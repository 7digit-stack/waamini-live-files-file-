{
  "mcpServers": {
    "waamini-mcp": {
      "command": "d:\\mcp for waamini\\.venv\\Scripts\\python.exe",
      "args": ["d:\\mcp for waamini\\waamini_mcp\\src\\server.py"]
    },
    "waamini-mysql": {
      "command": "npx",
      "args": ["-y", "@benborla29/mcp-server-mysql"],
      "env": {
        "MYSQL_HOST": "127.0.0.1",
        "MYSQL_PORT": "3306",
        "MYSQL_USER": "root",
        "MYSQL_PASSWORD": "",
        "MYSQL_DATABASE": "waamini",
        "ALLOW_INSERT_OPERATION": "false",
        "ALLOW_UPDATE_OPERATION": "false",
        "ALLOW_DELETE_OPERATION": "false"
      }
    }
  }
}
